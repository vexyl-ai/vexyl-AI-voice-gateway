GEMINI_TTS_PROMPT=



MURF_API_KEY=
# Optional:{"voice_id":"Natalie","style":"Angry","model:":"Gen2","multiNativeLocale":"ml-IN"}
MURF_MODEL=GEN2         # or FALCON for low-latency
