# TTS_PROVIDER=deepgram  # Uncomment to use Deepgram TTS

# API Configuration
DEEPGRAM_API_KEY=  # Get from https://console.deepgram.com
DEEPGRAM_API_URL=https://api.deepgram.com  # Deepgram API base URL
DEEPGRAM_MODEL=aura-2-harmonia-en  # Default voice model
DEEPGRAM_TIMEOUT=30000  # API timeout in milliseconds

# Popular Deepgram Voice Models (40+ available):
# aura-asteria-en - Balanced female voice (default)
# aura-luna-en - Warm female voice
# aura-stella-en - Clear female voice
# aura-athena-en - Professional female voice
# aura-hera-en - Expressive female voice
# aura-orion-en - Natural male voice
# aura-arcas-en - Deep male voice
# aura-perseus-en - Friendly male voice
# aura-angus-en - Authoritative male voice
# aura-orpheus-en - Smooth male voice
# aura-helios-en - Energetic male voice
# aura-zeus-en - Strong male voice

# Per-Language Voice Overrides (optional)
# Format: DEEPGRAM_VOICE_{LANG_CODE} where - becomes _
# DEEPGRAM_VOICE_EN_US=aura-asteria-en
# DEEPGRAM_VOICE_EN_GB=aura-luna-en
# DEEPGRAM_VOICE_EN_IN=aura-athena-en
# DEEPGRAM_VOICE_ES_ES=aura-orpheus-en
# DEEPGRAM_VOICE_FR_FR=aura-stella-en
# DEEPGRAM_VOICE_DE_DE=aura-hera-en

# Performance Notes:
# - REST API (batch processing, not streaming)
# - <200ms latency
# - 2 concurrent requests (free tier) / 15 (enterprise)
# - 480 requests per minute
# - 2,000 character limit per request
# - TTS_MAX_PARALLEL=2 recommended for free tier


AZURE_TTS_API_KEY=
AZURE_TTS_REGION=centralindia
# Optional: Voice Configuration
# ------------------------------
# Default voice (used when no language-specific voice is configured)
AZURE_TTS_VOICE_NAME=en-US-JennyNeural
AZURE_TTS_VOICE_ML_IN=ml-IN-SobhanaNeural

# Default voice style (for voices that support styles)
# Options: cheerful, sad, angry, excited, friendly, terrified, shouting,
#          unfriendly, whispering, hopeful, gentle, calm, serious, etc.
AZURE_TTS_VOICE_STYLE=excited
AZURE_TTS_RATE_ML_IN=1.1

# API timeout in milliseconds
AZURE_TTS_TIMEOUT=30000

# Server Configuration (Dynamic)
HTTP_HOST=127.0.0.1
HTTP_PORT=8081
AUDIOSOCKET_HOST=127.0.0.1
AUDIOSOCKET_PORT=8080

# Session Storage (Optional - Redis)
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0
SESSION_TTL=3600

# Optional testing
TEST_TTS_ON_START=false
TEST_GROQ_ON_START=false

# STT Provider Configuration
STT_PROVIDER=sarvam  # auto, sarvam, groq, gemini, deepgram, openai

# ==============================================================================
# DEEPGRAM STT CONFIGURATION (Nova-3 Streaming - Fastest Latency)
# ==============================================================================
# Deepgram Nova-3 offers 300-500ms latency (vs 2-5s batch providers)
# Uses WebSocket streaming with built-in endpointing (no VAD needed)
# Native 8kHz support - no audio upsampling required!
# Get API key from: https://console.deepgram.com

# Uses same API key as Deepgram TTS (DEEPGRAM_API_KEY above)
DEEPGRAM_STT_MODEL=nova-2             # nova-2 (stable) or nova-3 (latest)
DEEPGRAM_STT_ENDPOINTING=1000         # Silence duration (ms) to finalize utterance (500=fast, 1000=natural pauses)
DEEPGRAM_STT_INTERIM_RESULTS=true     # Enable real-time interim transcriptions
DEEPGRAM_STT_PUNCTUATE=true           # Add punctuation to transcripts
DEEPGRAM_STT_SMART_FORMAT=true        # Smart formatting (numbers, dates, etc.)

# Groq Whisper STT Configuration (Multi-language STT via REST API)
GROQ_API_KEY=
GROQ_MODEL=whisper-large-v3-turbo  # or whisper-large-v3 for better accuracy

# Gemini STT Configuration (Google Generative AI for cost-effective STT)
# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_STT_MODEL=gemini-2.0-flash-exp  # Fast, cost-effective batch model
GEMINI_STT_PROMPT=  # Optional: Custom transcription instructions

# ==============================================================================
# OPENAI WHISPER STT CONFIGURATION (Batch Processing via REST API)
# ==============================================================================
# OpenAI Whisper offers 99 language support with high accuracy
# Uses batch processing (2-5s latency) with Silero VAD for speech detection
# Same pattern as Groq Whisper (both use Whisper models)
# Get API key from: https://platform.openai.com/api-keys

# Uses same API key as other OpenAI services
OPENAI_API_KEY=
OPENAI_STT_MODEL=whisper-1              # whisper-1, gpt-4o-transcribe, gpt-4o-mini-transcribe
# OPENAI_STT_TEMPERATURE=0              # Optional: 0-1, lower = more deterministic (default: auto)

# Model Options:
# whisper-1 - Standard Whisper model, $0.006/min, good accuracy
# gpt-4o-transcribe - GPT-4o based, better accuracy (if available)
# gpt-4o-mini-transcribe - Faster/cheaper GPT-4o variant (if available)

MIN_SPEECH_DURATION=500  # Minimum milliseconds of speech before processing (increased to avoid false triggers)
MAX_SILENCE_DURATION=1500  # Maximum milliseconds of silence before processing (1.5s = natural pause detection)
MAX_BUFFER_DURATION=5000  # Maximum buffer duration before forcing transcription (5s = good balance)

# ==============================================================================
# AVR-VAD CONFIGURATION (Silero VAD v5 - ML-Based Voice Activity Detection)
# ==============================================================================
# Replaces manual energy-based silence detection for Gemini and Groq STT
# Used by: gemini-stt.js, groq-stt.js

VAD_MODEL=v5                     # Silero VAD model version (v5 recommended)
VAD_POSITIVE_THRESHOLD=0.5       # Speech start threshold (0.0-1.0, higher = stricter)
VAD_NEGATIVE_THRESHOLD=0.35      # Speech stop threshold (0.0-1.0, must be < positive)
VAD_REDEMPTION_FRAMES=8          # Pause tolerance before declaring speech end (8 frames = 768ms)
VAD_MIN_SPEECH_FRAMES=3          # Minimum frames to qualify as speech (filters noise, 3 frames = 288ms)
VAD_PRE_SPEECH_FRAMES=1          # Pre-buffer frames before speech start (1 frame = 96ms)

# ==============================================================================
# UTTERANCE WINDOW CONFIGURATION (Combines Split Transcriptions)
# ==============================================================================
# Purpose: When MAX_BUFFER_DURATION splits long speech into multiple buffers,
# the utterance window combines transcripts before sending to LLM
# Used by: server.js (Gemini/Groq batch STT only, Sarvam bypasses this)

UTTERANCE_WINDOW_SIZE=4                  # Max utterances to buffer (prevents memory overflow)
REDEMPTION_MS=1400                       # Wait time after last transcript before processing (1.4s)
UTTERANCE_COMBINATION_WINDOW=10000       # Combine transcripts arriving within this window (10s)
UTTERANCE_CHECK_INTERVAL=500             # System idle check interval (0.5s)
UTTERANCE_MAX_WAIT=30000                 # Maximum wait for system to become idle (30s)

# ==============================================================================
# HUMAN-IN-THE-LOOP (HITL) CALL TRANSFER CONFIGURATION
# ==============================================================================
# Enable webhook-based call transfer when LLM requests human agent escalation
# Transfer logic is implemented by end-user via REST API webhook (any language)
# Supports: Z-Assist, Litebot, n8n (via shouldEscalate flag/metadata)

# Transfer Feature Toggle
TRANSFER_ENABLED=false

# Transfer Webhook Endpoint (User implements this in their preferred language)
# The webhook receives: { channel, callerid, uuid, timestamp }
# Expected response: HTTP 200 OK for success, any non-200 for failure
# Example implementations provided in docs (Node.js, Python, PHP)
 TRANSFER_ENDPOINT=http://127.0.0.1/transfer.php

# Transfer Timeout (milliseconds)
# Max wait time for webhook response before treating as failure
# Default: 5000ms (5 seconds) - Balance between responsiveness and reliability
TRANSFER_TIMEOUT=5000

# ==============================================================================
# TRANSFER AUDIO MESSAGES (Optional - WAV files, 8kHz, 16-bit PCM, mono)
# ==============================================================================
# If not configured, system will use TTS to generate transfer messages on-the-fly

# Default Transfer Message (fallback if language-specific not available)
# TRANSFER_MESSAGE=/opt/assist/audio/transfer-message.wav

# Language-Specific Transfer Messages
# TRANSFER_MESSAGE_EN=/opt/assist/audio/transfer-message-en.wav
# TRANSFER_MESSAGE_ML=/opt/assist/audio/transfer-message-ml.wav
# TRANSFER_MESSAGE_HI=/opt/assist/audio/transfer-message-hi.wav
# TRANSFER_MESSAGE_TA=/opt/assist/audio/transfer-message-ta.wav

# Default Error Message (when webhook fails/times out)
# TRANSFER_ERROR_MESSAGE=/opt/assist/audio/transfer-failed.wav

# Language-Specific Error Messages
# TRANSFER_ERROR_MESSAGE_EN=/opt/assist/audio/transfer-failed-en.wav
# TRANSFER_ERROR_MESSAGE_ML=/opt/assist/audio/transfer-failed-ml.wav
# TRANSFER_ERROR_MESSAGE_HI=/opt/assist/audio/transfer-failed-hi.wav
# TRANSFER_ERROR_MESSAGE_TA=/opt/assist/audio/transfer-failed-ta.wav

# Fallback Text Messages (used with TTS if audio files not configured)
TRANSFER_MESSAGE_TEXT_EN=Please hold while I transfer you to a human agent.
TRANSFER_MESSAGE_TEXT_ML=ദയവായി കാത്തിരിക്കൂ, ഞാൻ നിങ്ങളെ ഒരു മനുഷ്യ ഏജന്റിലേക്ക് കൈമാറുന്നു.
TRANSFER_MESSAGE_TEXT_HI=कृपया प्रतीक्षा करें, मैं आपको एक मानव एजेंट को स्थानांतरित कर रहा हूं।
TRANSFER_MESSAGE_TEXT_TA=தயவு செய்து காத்திருங்கள், நான் உங்களை ஒரு மனித முகவருக்கு மாற்றுகிறேன்.

TRANSFER_ERROR_TEXT_EN=I am sorry, I was unable to transfer you. Please try calling again.
TRANSFER_ERROR_TEXT_ML=ക്ഷമിക്കണം, എനിക്ക് നിങ്ങളെ കൈമാറാൻ കഴിഞ്ഞില്ല. ദയവായി വീണ്ടും വിളിക്കുക.
TRANSFER_ERROR_TEXT_HI=मुझे खेद है, मैं आपको स्थानांतरित करने में असमर्थ था। कृपया पुनः कॉल करें।
TRANSFER_ERROR_TEXT_TA=மன்னிக்கவும், என்னால் உங்களை மாற்ற முடியவில்லை. தயவு செய்து மீண்டும் அழைக்கவும்.

# Barge-in Configuration (Audio Interruption)
ENABLE_BARGE_IN=true  # Allow users to interrupt AI while speaking
BARGE_IN_THRESHOLD=500  # Energy threshold for first-pass detection
BARGE_IN_DELAY=200  # Minimum milliseconds of speech before interrupting
BARGE_IN_USE_VAD=true  # Use Silero VAD for accurate speech detection (filters noise)
BARGE_IN_VAD_THRESHOLD=0.5  # VAD probability threshold (0.0-1.0, higher = stricter)

# Processing Sound Configuration
PROCESSING_SOUND_ENABLED=false  # Play sound during LLM processing and TTS conversion
PROCESSING_SOUND_FILE=/opt/assist/sounds/processing_ambient.wav  # Path to processing sound file
PROCESSING_SOUND_VOLUME=0.3  # Volume level (0.0 to 1.0)
PROCESSING_SOUND_LOOP=true  # Loop the sound until response is ready
PROCESSING_SOUND_TYPE=chime  # Sound type: 'chime', 'ambient', 'beep'
PROCESSING_SOUND_START_DELAY=0  # Delay in milliseconds before starting processing sound (0 = immediate)

# TTS Response Splitting Configuration
ENABLE_TTS_SPLITTING=true  # Enable splitting long responses into chunks for faster audio delivery
TTS_CHUNK_SIZE=100  # Maximum characters per chunk (safe limit for Google TTS Chirp3 voices)
TTS_MAX_PARALLEL=2  # Maximum parallel TTS requests to process simultaneously (ElevenLabs only allows 1 concurrent request)
TTS_SPLIT_DELIMITERS=.!?।  # Sentence delimiters for smart text splitting
TTS_PHRASE_DELIMITERS=,;:  # Phrase delimiters for secondary splitting if sentences are too long




## OUTBOUND CALL
OUTBOUND_ENABLED=true
OUTBOUND_ORIGINATE_ENDPOINT=http://127.0.0.1/originate.php
# Webhook timeout in milliseconds
OUTBOUND_TIMEOUT=10000


TTS_CACHE_ENABLED=true
TTS_CACHE_DIR=/opt/assist/cache/tts
TTS_CACHE_MAX_SIZE_MB=1000
TTS_CACHE_MAX_AGE_DAYS=10
TTS_CACHE_CLEANUP_STRATEGY=lru

# ==============================================================================
# WEBSOCKET AUDIO CONFIGURATION (Browser Widget)
# ==============================================================================
# Enable WebSocket Audio Server for browser-based voice assistant
WEBSOCKET_AUDIO_ENABLED=true
WEBSOCKET_AUDIO_PORT=8082
WEBSOCKET_AUDIO_HOST=0.0.0.0

# CORS origins allowed to connect (comma-separated, empty = allow all)
# Example: https://example.com,https://app.example.com
WEBSOCKET_AUDIO_ALLOWED_ORIGINS=

# Max connections per IP address (rate limiting)
WEBSOCKET_AUDIO_MAX_PER_IP=5

# Optional: API key for widget authentication (leave empty for no auth)
WEBSOCKET_AUDIO_API_KEY=