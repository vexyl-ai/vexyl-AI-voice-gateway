LOG_LATENCY=true
SARVAM_API_KEY=

# ==============================================================================
# LICENSE CONFIGURATION
# ==============================================================================
# Leave empty or omit for FREE tier (4 concurrent calls, never expires)
# Add a valid license key to unlock higher tiers (Starter, Professional, Enterprise, Unlimited)
# To get your Machine ID for a machine-bound license: node server.js --get-machine-id
LICENSE_KEY=

# ==============================================================================
# OPERATION MODE
# ==============================================================================
# Set to 'true' for Gateway Mode (audio passthrough to LLM WebSocket)
# Set to 'false' for Standard Mode (STT → LLM → TTS pipeline)
GATEWAY_MODE=false

# ==============================================================================
# GATEWAY MODE CONFIGURATION (Only used when GATEWAY_MODE=true)
# ==============================================================================

# LLM WebSocket Endpoint
# OpenAI Realtime API example:
# LLM_WEBSOCKET_URL=wss://api.openai.com/v1/realtime?model=gpt-4o-realtime-preview-2024-10-01
# ElevenLabs Conversational AI example (requires agent_id):
# LLM_WEBSOCKET_URL=wss://api.elevenlabs.io/v1/convai/conversation?agent_id=YOUR_AGENT_ID


# LLM API Key (for Gateway Mode)
# For OpenAI: sk-proj-xxxxx
# For ElevenLabs: sk_xxxxx (get from https://elevenlabs.io/app/conversational-ai)
LLM_WEBSOCKET_URL=wss://api.elevenlabs.io/v1/convai/conversation?agent_id=
LLM_API_KEY=
#LLM_WEBSOCKET_URL=wss://api.openai.com/v1/realtime?model=gpt-4o-realtime-preview-2024-10-01

# Audio Format (pcm16, g711_ulaw, g711_alaw)
AUDIO_FORMAT=pcm16

# Sample Rate (8000, 16000, 24000)
# ElevenLabs: 16000, OpenAI: 24000 (provider-specific)
# Note: Asterisk always sends 8kHz, resampling is provider-specific
SAMPLE_RATE=24000

# Gateway Session Configuration
GATEWAY_MODALITIES=audio,text
GATEWAY_VOICE=marin  # OpenAI voices: alloy, echo, fable, onyx, nova, shimmer
GATEWAY_INSTRUCTIONS=You are a helpful AI assistant. Be concise and conversational.
GATEWAY_TEMPERATURE=0.8
GATEWAY_MAX_TOKENS=4096

# Voice Activity Detection (VAD)
GATEWAY_VAD_TYPE=server_vad  # server_vad or none
GATEWAY_VAD_THRESHOLD=0.5
GATEWAY_VAD_PREFIX_MS=300
GATEWAY_VAD_SILENCE_MS=500

# Optional Features
GATEWAY_ENABLE_TRANSCRIPTION=false  # Enable input audio transcription (OpenAI only)
GATEWAY_TRANSCRIPTION_MODEL=whisper-1  # Transcription model for OpenAI (required if transcription enabled)
GATEWAY_LOG_TRANSCRIPTS=true  # Log conversation transcripts to console
GATEWAY_LOG_RATE_LIMITS=false  # Log API rate limit information
GATEWAY_COMMIT_ON_SILENCE=false  # Commit audio buffer on Asterisk silence detection

# Gateway Performance & Memory Management
MAX_AUDIO_BUFFER_SIZE=100  # Max chunks to buffer before dropping oldest (prevents memory overflow)
MAX_PLAYBACK_QUEUE_SIZE=50  # Max chunks in playback queue before dropping oldest
GATEWAY_MAX_ERRORS=10  # Max errors before circuit breaker opens (prevents cascade failures)

# ==============================================================================
# STANDARD MODE CONFIGURATION (Only used when GATEWAY_MODE=false)
# ==============================================================================

# LLM Provider Configuration
# Options: 'sarvam', 'flowise', 'litebot', 'zassist', or 'n8n'
LLM_PROVIDER=litebot

# Flowise Configuration
FLOWISE_API_URL=
FLOWISE_FLOW_ID=

# Litebot Configuration
LITEBOT_API_URL=
LITEBOT_BOT_ID=
LITEBOT_TIMEOUT=30000


# ==============================================================================
# N8N WORKFLOW INTEGRATION (Flexible Webhook-Based LLM Provider)
# ==============================================================================
# n8n is an open-source workflow automation platform with 400+ integrations
# Perfect for creating custom AI assistants with any LLM (OpenAI, Anthropic, etc.)
# Docs: https://docs.n8n.io/integrations/builtin/core-nodes/n8n-nodes-base.webhook/

# N8N_WEBHOOK_URL - Your n8n workflow webhook endpoint
# Example: http://your-n8n-instance.com/webhook/voice-assistant
# Create webhook in n8n: Add "Webhook" node → Set HTTP Method to POST → Copy webhook URL
N8N_WEBHOOK_URL=

# N8N_TIMEOUT - API request timeout in milliseconds (default: 30000)
N8N_TIMEOUT=30000

# N8N_AUTH_HEADER - Optional authentication header (if webhook is secured)
# Example: Bearer your_token_here
# N8N_AUTH_HEADER=

# ==============================================================================
# CUSTOM RESPONSE FIELD MAPPING (Optional - for non-standard responses)
# ==============================================================================
# By default, n8n integration checks these fields: response, text, message, output, result, answer, reply
# If your workflow uses different field names, specify them here using dot notation

# N8N_RESPONSE_FIELD - Custom path to response text in n8n output
# Example: data.output.message (will extract: response.data.output.message)
# N8N_RESPONSE_FIELD=

# N8N_SESSION_FIELD - Custom path to session ID in n8n output
# Example: session.id (will extract: response.session.id)
# N8N_SESSION_FIELD=



###############CUSTOM_LLM###################


#LLM_PROVIDER=custom
#CUSTOM_LLM_URL=https://node95.wa.lonelypx.com/webhook/1a4bbfcb-e1b6-42f6-b6b0-9292129fb0f5

# Optional
#CUSTOM_LLM_TIMEOUT=30000          # Request timeout in ms (default: 30000)
#CUSTOM_LLM_AUTH_TYPE=none         # none | bearer | header
#CUSTOM_LLM_AUTH_TOKEN=            # Your auth token
#CUSTOM_LLM_AUTH_HEADER=X-Api-Key  # Custom header name (for auth_type=header)

# Advanced: Custom field mapping (if your API uses non-standard field names)
#CUSTOM_LLM_RESPONSE_FIELD=data.output.message  # Dot-notation path to response text
#CUSTOM_LLM_SESSION_FIELD=data.sessionId        # Dot-notation path to session ID

###############CUSTOM_LLM###################



# Timeout Messages Configuration
TIMEOUT_MESSAGE_ENABLED=true
LLM_TIMEOUT_MESSAGE=I'm experiencing some technical difficulties. Please hold on while I try to process your request.
LLM_TIMEOUT_RETRY_MESSAGE=I'm still working on your request. This is taking longer than usual, please bear with me.
LLM_FINAL_TIMEOUT_MESSAGE=I'm sorry, I'm having trouble processing your request right now. Please try again in a moment.


